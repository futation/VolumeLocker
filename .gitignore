# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/

# 虚拟环境(用 setup_env.bat 重建,不进版本库)
.venv/

# ── 编辑器 ──
# 只收 launch.json / settings.json(固定 .venv 解释器用),其他本地配置不进
.vscode/*
!.vscode/launch.json
!.vscode/settings.json

# ── 运行时产物 ──
# 配置在 %LOCALAPPDATA%\VolumeLocker\ 下,不在项目里;这里只挡意外落地的文件
*.log

# ── 打包产物 ──
# build/ 是 PyInstaller 中间目录,dist/ 是打包产物 —— 都不进版本库。
# 打包好的 exe 建议挂 GitHub Releases。
build/
dist/

# 图标原图是源素材,在 assets/VolumeControl.png;icon.ico 由 tools/make_icon.py 生成。

# 临时文件
*.tmp
